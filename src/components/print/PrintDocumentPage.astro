---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import Footer from '../Footer.astro';
import LegalDialogs from '../legal/LegalDialogs.astro';
import { responsiveImage } from '../../lib/images';
import { downloads, printPages, type PrintDoc } from '../../data/print';
import { cvPath, homePath, printPath, ui, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  doc: PrintDoc;
}

const { lang, doc } = Astro.props;
const t = ui[lang];

const pages = await Promise.all(
  printPages(doc, lang).map(async (page) => ({ ...page, image: await responsiveImage(page.src, [600, 900, 1200, 1654]) })),
);
const total = pages.length;
/** A one-page document is shown as a single sheet, without the flip book. */
const single = total === 1;
const megabytes = new Intl.NumberFormat(lang === 'de' ? 'de-AT' : 'en', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const files = downloads[doc].map((file) => ({
  ...file,
  // No-break space, so "MB" never ends up alone on the next line.
  size: `${megabytes.format(statSync(join(process.cwd(), 'public', file.href)).size / 1024 ** 2)} MB`,
}));

/** Per document: page title, heading, lead, and the link to the other document. */
const docCopy = {
  portfolio: {
    en: {
      title: 'Print portfolio',
      description:
        'The printed portfolio of Fabian Trutschnig as a flip-through booklet, with PDF downloads for screen and print.',
      heading: ['Print', 'portfolio'],
      lead: 'The printed edition of my portfolio. Flip through it like the real booklet: click a page or drag its corner.',
      note: 'The print edition is in German.',
      stage: 'Print portfolio, flip-through view',
      zoomTitle: 'Print portfolio, zoomed view',
      hint: 'Arrow keys, click, or drag a page corner. Zoom in to read the pages.',
      other: { label: 'View my CV', href: cvPath.en },
    },
    de: {
      title: 'Print-Portfolio',
      description: 'Das gedruckte Portfolio von Fabian Trutschnig zum Durchblättern, mit PDF-Download für Bildschirm und Druck.',
      heading: ['Print', 'Portfolio'],
      lead: 'Die gedruckte Ausgabe meines Portfolios. Zum Durchblättern wie das echte Heft: Seite anklicken oder an der Ecke ziehen.',
      note: '',
      stage: 'Print-Portfolio, Blätteransicht',
      zoomTitle: 'Print-Portfolio, vergrößerte Ansicht',
      hint: 'Pfeiltasten, Klick oder an der Seitenecke ziehen. Zum Lesen die Seiten heranzoomen.',
      other: { label: 'Lebenslauf ansehen', href: cvPath.de },
    },
  },
  cv: {
    en: {
      title: 'CV',
      description: 'The CV of Fabian Trutschnig as a preview, with PDF downloads for screen and print.',
      heading: ['My', 'CV'],
      lead: 'My CV on a single page. Zoom in to read it, or download it as a PDF.',
      note: 'The CV is in German.',
      stage: 'CV, page view',
      zoomTitle: 'CV, zoomed view',
      hint: 'Click the page or use zoom to read it.',
      other: { label: 'View the print portfolio', href: printPath.en },
    },
    de: {
      title: 'Lebenslauf',
      description: 'Der Lebenslauf von Fabian Trutschnig als Vorschau, mit PDF-Download für Bildschirm und Druck.',
      heading: ['Mein', 'Lebenslauf'],
      lead: 'Mein Lebenslauf auf einer Seite. Zum Lesen heranzoomen oder als PDF herunterladen.',
      note: '',
      stage: 'Lebenslauf, Seitenansicht',
      zoomTitle: 'Lebenslauf, vergrößerte Ansicht',
      hint: 'Zum Lesen die Seite anklicken oder heranzoomen.',
      other: { label: 'Print-Portfolio ansehen', href: printPath.de },
    },
  },
}[doc][lang];

const copy = {
  en: {
    ...docCopy,
    pdf: 'Download PDF',
    downloadMenu: 'PDF versions',
    kinds: { digital: 'Digital', print: 'Print' },
    prev: 'Previous page',
    next: 'Next page',
    status: `Page {pages} of ${total}`,
    fullscreen: 'Full screen',
    exitFullscreen: 'Exit full screen',
    zoom: 'Zoom',
    zoomIn: 'Zoom in',
    zoomOut: 'Zoom out',
    zoomLevel: 'Zoom level',
  },
  de: {
    ...docCopy,
    pdf: 'PDF herunterladen',
    downloadMenu: 'PDF-Versionen',
    kinds: { digital: 'Digital', print: 'Print' },
    prev: 'Vorherige Seite',
    next: 'Nächste Seite',
    status: `Seite {pages} von ${total}`,
    fullscreen: 'Vollbild',
    exitFullscreen: 'Vollbild beenden',
    zoom: 'Zoomen',
    zoomIn: 'Vergrößern',
    zoomOut: 'Verkleinern',
    zoomLevel: 'Zoomstufe',
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description}>
  {/* Lets the CSS hold back the page stack until the flip book has taken it over. */}
  <script is:inline slot="head">
    document.documentElement.classList.add('js');
  </script>

  <div class="wrap">
    <PageHeader lang={lang} paths={doc === 'cv' ? cvPath : printPath} />
    <main id="main">
      <section class="print-intro">
        <div class="rule-row">
          <a href={homePath[lang]}>← {t.home.toUpperCase()}</a>
          <a href={copy.other.href}>{copy.other.label.toUpperCase()} →</a>
        </div>
        <div class="section-intro print-heading">
          <h1 class="display">{copy.heading[0]}<span class="display-script">{copy.heading[1]}</span></h1>
          <div class="print-lead">
            <p>{copy.lead}{copy.note && <> <em>{copy.note}</em></>}</p>
            {/* Two PDFs of the same layout: one for screen and e-mail, one for the print shop. */}
            <details class="download" data-download>
              <summary class="pill pill-petrol">
                {copy.pdf} <span aria-hidden="true">↓</span>
              </summary>
              <ul class="download-menu" aria-label={copy.downloadMenu}>
                {
                  files.map((file) => (
                    <li>
                      <a href={file.href} download>
                        <span class="download-name">{copy.kinds[file.kind]}</span>
                        <span class="download-meta">
                          {file.meta[lang]} · {file.size}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>
        </div>
      </section>
    </main>
  </div>

  <section class:list={['print-stage', { 'is-single': single }]} aria-label={copy.stage} data-stage>
    <div class="book-frame">
      <div class="book" data-book>
        {
          pages.map((page, i) => (
            <div class="book-page" data-density={i === 0 || i === total - 1 ? 'hard' : 'soft'}>
              <img
                src={page.image.src}
                srcset={page.image.srcSet}
                sizes={single ? 'min(100vw, 60svh)' : '(min-width: 560px) min(50vw, 70svh), 100vw'}
                width={page.image.width}
                height={page.image.height}
                alt={page.alt}
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="book-controls" hidden data-controls>
      <button class="round-btn" type="button" aria-label={copy.prev} hidden={single} data-prev>←</button>
      <p class="book-status" aria-live="polite" hidden={single} data-status={copy.status}></p>
      <button class="round-btn" type="button" aria-label={copy.next} hidden={single} data-next>→</button>
      <button class="book-tool" type="button" data-zoom-open>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6"></path>
        </svg>
        {copy.zoom}
      </button>
      <button
        class="book-tool"
        type="button"
        hidden
        data-fullscreen
        data-enter={copy.fullscreen}
        data-exit={copy.exitFullscreen}
      >
        {copy.fullscreen}
      </button>
    </div>
    <p class="book-hint" hidden data-hint>{copy.hint}</p>

    {/* Inside the stage, so it stays on screen when the stage is in full screen. */}
    <dialog class="zoom" aria-label={copy.zoomTitle} data-zoom>
      <div class="zoom-bar">
        <div class="zoom-group" hidden={single}>
          <button class="round-btn" type="button" aria-label={copy.prev} data-zoom-prev>←</button>
          <p class="book-status" data-zoom-status></p>
          <button class="round-btn" type="button" aria-label={copy.next} data-zoom-next>→</button>
        </div>
        <div class="zoom-group">
          <button class="round-btn" type="button" aria-label={copy.zoomOut} data-zoom-out>−</button>
          <output class="zoom-level" aria-label={copy.zoomLevel} data-zoom-level>100 %</output>
          <button class="round-btn" type="button" aria-label={copy.zoomIn} data-zoom-in>+</button>
          <form class="zoom-close" method="dialog">
            <button class="round-btn" aria-label={t.close}>✕</button>
          </form>
        </div>
      </div>
      <div class="zoom-viewport" data-zoom-viewport>
        <div class="zoom-spread" data-zoom-spread></div>
      </div>
    </dialog>
  </section>

  <div class="print-footer on-dark">
    <div class="wrap">
      <Footer lang={lang} link={{ label: t.allProjects, href: `${homePath[lang]}#work` }} />
    </div>
  </div>
  <LegalDialogs lang={lang} />
  <script>
    import { PageFlip } from 'page-flip/dist/js/page-flip.module.js';
  
    const stage = document.querySelector<HTMLElement>('[data-stage]')!;
    const book = stage.querySelector<HTMLElement>('[data-book]')!;
    const pages = book.querySelectorAll<HTMLElement>('.book-page');
    const images = book.querySelectorAll('img');
    const status = stage.querySelector<HTMLElement>('[data-status]')!;
    const prev = stage.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = stage.querySelector<HTMLButtonElement>('[data-next]')!;
    const fullscreen = stage.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
    // One printed page in pixels, from the attributes: the rendered size is still the placeholder's.
    const width = Number(images[0].getAttribute('width'));
    const height = Number(images[0].getAttribute('height'));

    // A single sheet (the CV) has nothing to turn, so it gets no flip book; clicking it opens the zoom.
    const flip =
      pages.length > 1
        ? new PageFlip(book, {
            // "stretch" scales the book to the frame's width and switches to single pages below 2 × minWidth.
            width,
            height,
            size: 'stretch',
            minWidth: 280,
            maxWidth: width,
            minHeight: 396,
            maxHeight: height,
            showCover: true,
            usePortrait: true,
            mobileScrollSupport: true,
            maxShadowOpacity: 0.4,
            flippingTime: matchMedia('(prefers-reduced-motion: reduce)').matches ? 250 : 800,
          })
        : null;
    const portrait = () => !flip || flip.getOrientation() === 'portrait';
    const currentIndex = () => flip?.getCurrentPageIndex() ?? 0;

    /** The page indexes shown together with `index`: the covers alone, the rest as spreads, or one at a time on narrow screens. */
    function viewOf(index: number) {
      const last = pages.length - 1;
      if (portrait() || index === 0 || index === last) return [index];
      const left = index % 2 === 1 ? index : index - 1;
      return left === last ? [left] : [left, left + 1];
    }

    /** "Page 4–5 of 18", with the printed page numbers. */
    function statusText(view: number[]) {
      return status.dataset.status!.replace('{pages}', view.map((i) => i + 1).join('–'));
    }

    function update(index = currentIndex()) {
      status.textContent = statusText(viewOf(index));
      prev.disabled = index === 0;
      next.disabled = index >= pages.length - (portrait() ? 1 : 2);
      // Fetch the next pages ahead of time, so a page never turns over blank.
      for (let i = index; i < Math.min(index + 5, images.length); i++) images[i].loading = 'eager';
    }

    if (flip) {
      flip.on('flip', (e) => update(e.data));
      flip.on('changeOrientation', () => update());
      flip.loadFromHTML(pages);
    }
    update(0);

    prev.addEventListener('click', () => flip?.flipPrev());
    next.addEventListener('click', () => flip?.flipNext());
    document.addEventListener('keydown', (e) => {
      if (!flip || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || document.querySelector('dialog[open]')) return;
      if (e.key === 'ArrowRight') flip.flipNext();
      else if (e.key === 'ArrowLeft') flip.flipPrev();
      else return;
      e.preventDefault();
    });

    // Download menu: closes on a click elsewhere, on Escape, and once a version is picked.
    const download = document.querySelector<HTMLDetailsElement>('[data-download]')!;
    document.addEventListener('click', (e) => {
      if (download.open && !download.contains(e.target as Node)) download.open = false;
    });
    download.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !download.open) return;
      download.open = false;
      download.querySelector('summary')!.focus();
    });
    download.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (download.open = false)));
  
    if (document.fullscreenEnabled) {
      fullscreen.hidden = false;
      fullscreen.addEventListener('click', () =>
        document.fullscreenElement ? document.exitFullscreen() : stage.requestFullscreen(),
      );
      document.addEventListener('fullscreenchange', () => {
        fullscreen.textContent = document.fullscreenElement ? fullscreen.dataset.exit! : fullscreen.dataset.enter!;
      });
    }
  
    stage.querySelectorAll<HTMLElement>('[data-controls], [data-hint]').forEach((el) => (el.hidden = false));
  
    // Zoom: the open spread in a dialog filling the screen, where it can be enlarged far enough to read.
    const zoom = stage.querySelector<HTMLDialogElement>('[data-zoom]')!;
    const viewport = zoom.querySelector<HTMLElement>('[data-zoom-viewport]')!;
    const spread = zoom.querySelector<HTMLElement>('[data-zoom-spread]')!;
    const zoomStatus = zoom.querySelector<HTMLElement>('[data-zoom-status]')!;
    const zoomPrev = zoom.querySelector<HTMLButtonElement>('[data-zoom-prev]')!;
    const zoomNext = zoom.querySelector<HTMLButtonElement>('[data-zoom-next]')!;
    const zoomIn = zoom.querySelector<HTMLButtonElement>('[data-zoom-in]')!;
    const zoomOut = zoom.querySelector<HTMLButtonElement>('[data-zoom-out]')!;
    const zoomLevel = zoom.querySelector<HTMLOutputElement>('[data-zoom-level]')!;
    const percent = new Intl.NumberFormat(document.documentElement.lang, { style: 'percent', maximumFractionDigits: 0 });
    // At 400 % a page on a laptop screen is about as large as the 1654 px export.
    const maxScale = 4;
    const step = 1.5;
    /** Page indexes in the dialog. */
    let shown: number[] = [];
    /** 1 = the whole spread fits the window. */
    let scale = 1;
  
    /** Sizes the spread for `scale` and keeps the point under (x, y) where it was. */
    function render(x?: number, y?: number) {
      // Labels first: they can change the height of the bar, and so the room for the pages.
      zoomLevel.value = percent.format(scale);
      zoomOut.disabled = scale <= 1;
      zoomIn.disabled = scale >= maxScale;
      viewport.classList.toggle('is-zoomed', scale > 1);
  
      const box = viewport.getBoundingClientRect();
      x ??= box.left + box.width / 2;
      y ??= box.top + box.height / 2;
      const before = spread.getBoundingClientRect();
      const rx = (x - before.left) / before.width;
      const ry = (y - before.top) / before.height;
  
      const style = getComputedStyle(viewport);
      const room = {
        width: viewport.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight),
        height: viewport.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom),
      };
      const spreadWidth = Math.min(room.width, (room.height * shown.length * width) / height) * scale;
      spread.style.width = `${spreadWidth}px`;
      // The browser picks the file from srcset by this, so a sharper one loads as the pages grow.
      for (const img of spread.querySelectorAll('img')) img.sizes = `${Math.ceil(spreadWidth / shown.length)}px`;
  
      const after = spread.getBoundingClientRect();
      if (Number.isFinite(rx) && Number.isFinite(ry)) {
        viewport.scrollBy(after.left + rx * after.width - x, after.top + ry * after.height - y);
      }
    }
  
    function setScale(next: number, x?: number, y?: number) {
      scale = Math.min(maxScale, Math.max(1, next));
      render(x, y);
    }
  
    function showView(view: number[]) {
      shown = view;
      scale = 1;
      zoomStatus.textContent = statusText(view);
      zoomPrev.disabled = view[0] === 0;
      zoomNext.disabled = view.at(-1) === pages.length - 1;
      const copies = view.map((i) => {
        const img = document.createElement('img');
        img.alt = images[i].alt;
        img.width = width;
        img.height = height;
        img.draggable = false;
        return img;
      });
      spread.replaceChildren(...copies);
      render();
      viewport.scrollTo(0, 0);
      // Only now that `sizes` is set, so the first request is already for the right file.
      copies.forEach((img, n) => {
        img.srcset = images[view[n]].srcset;
        img.src = images[view[n]].getAttribute('src')!;
      });
    }
  
    const openZoom = () => {
      zoom.showModal();
      showView(viewOf(currentIndex()));
    };
    stage.querySelector('[data-zoom-open]')!.addEventListener('click', openZoom);
    if (!flip) pages[0].addEventListener('click', openZoom);
    // The book waits on the page that was read last.
    zoom.addEventListener('close', () => {
      flip?.turnToPage(shown[0]);
      update(shown[0]);
    });
    zoomPrev.addEventListener('click', () => showView(viewOf(shown[0] - 1)));
    zoomNext.addEventListener('click', () => showView(viewOf(shown.at(-1)! + 1)));
    zoomIn.addEventListener('click', () => setScale(scale * step));
    zoomOut.addEventListener('click', () => setScale(scale / step));
    // Window resizes, rotation, and the bar wrapping onto a second line.
    new ResizeObserver(() => zoom.open && render()).observe(viewport);
  
    zoom.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      if (e.key === 'ArrowRight') zoomNext.disabled || zoomNext.click();
      else if (e.key === 'ArrowLeft') zoomPrev.disabled || zoomPrev.click();
      else if (e.key === '+' || e.key === '=') setScale(scale * step);
      else if (e.key === '-') setScale(scale / step);
      else if (e.key === '0') setScale(1);
      else return;
      e.preventDefault();
    });
  
    // Mouse: a click zooms in on that spot or back out; dragging moves the enlarged pages. Touch scrolls natively.
    let drag: { x: number; y: number; left: number; top: number; moved: boolean } | null = null;
    let dragged = false;
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, y: e.clientY, left: viewport.scrollLeft, top: viewport.scrollTop, moved: false };
      viewport.setPointerCapture(e.pointerId);
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      drag.moved = true;
      viewport.classList.add('is-dragging');
      viewport.scrollTo(drag.left - dx, drag.top - dy);
    });
    const endDrag = () => {
      dragged = drag?.moved ?? false;
      drag = null;
      viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('click', (e) => {
      if (dragged) return void (dragged = false);
      setScale(scale > 1 ? 1 : 2.5, e.clientX, e.clientY);
    });
  
    // Trackpad pinches arrive as wheel events with ctrlKey set.
    viewport.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        setScale(scale * Math.exp(-e.deltaY * 0.01), e.clientX, e.clientY);
      },
      { passive: false },
    );
  
    // Two-finger pinch on touch screens; `touch-action` keeps the browser from zooming the whole page instead.
    let pinch: { distance: number; scale: number } | null = null;
    const distance = (t: TouchList) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
    viewport.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length === 2) pinch = { distance: distance(e.touches), scale };
      },
      { passive: true },
    );
    viewport.addEventListener(
      'touchmove',
      (e) => {
        if (!pinch || e.touches.length !== 2) return;
        e.preventDefault();
        const [a, b] = [e.touches[0], e.touches[1]];
        setScale((pinch.scale * distance(e.touches)) / pinch.distance, (a.clientX + b.clientX) / 2, (a.clientY + b.clientY) / 2);
      },
      { passive: false },
    );
    viewport.addEventListener('touchend', (e) => {
      if (e.touches.length < 2) pinch = null;
    });
  </script>
</Base>


<style>
  .print-intro {
    padding-top: var(--block);
  }
  .print-intro .rule-row a {
    color: var(--ink);
  }
  /* The script word runs wider than the shared grid column, so the lead keeps to the right edge
     and only moves underneath the heading when there is no room beside it. */
  .print-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .print-lead {
    flex: 0 1 420px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .print-lead p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .print-lead em {
    color: var(--ink);
    font-style: normal;
    font-weight: 600;
  }
  /* Download: the pill opens a small menu with the digital and the print version. */
  .download {
    position: relative;
  }
  .download summary {
    cursor: pointer;
    list-style: none;
  }
  .download summary::-webkit-details-marker {
    display: none;
  }
  .download summary span {
    transition: transform 0.2s;
  }
  .download[open] summary span {
    transform: rotate(180deg);
  }
  .download-menu {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--space-2));
    left: 0;
    width: max-content;
    max-width: min(22rem, calc(100vw - 2 * var(--gutter)));
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 1rem;
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .download-menu a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: var(--tap);
    padding: var(--space-3) var(--space-4);
    border-radius: 0.625rem;
    color: var(--ink);
    transition: background-color 0.2s;
  }
  .download-name {
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .download-name::after {
    content: ' ↓';
    color: var(--petrol);
  }
  .download-meta {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .print-stage {
    --book-ratio: calc(2 * 1654 / 2339);
    background: var(--sand);
    padding: clamp(var(--space-6), 5vw, var(--space-8)) var(--gutter);
  }
  /* As wide as the column allows, but never so wide that an open spread is taller than the screen. */
  .book-frame {
    width: min(100%, calc((100svh - 15rem) * var(--book-ratio)));
    margin-inline: auto;
  }
  .book-page {
    background: var(--paper);
  }
  /* page-flip marks each shown page as left or right; the shade along the fold makes the spread read as paper. */
